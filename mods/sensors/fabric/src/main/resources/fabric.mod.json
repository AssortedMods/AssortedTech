{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "issues": "${issue_tracker}"
  },
  "license": "${license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.grim3212.assorted.sensors.AssortedSensorsFabric"
    ],
    "client": [
      "com.grim3212.assorted.sensors.AssortedSensorsFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "minecraft": "${fabric_mc_version_range}",
    "java": ">=25",
    "assortedlib": ">=${assortedlib_version}"
  }
}
